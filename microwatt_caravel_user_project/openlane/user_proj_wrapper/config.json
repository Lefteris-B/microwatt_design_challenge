{
    "//": "=== Design files ===",
    "VERILOG_FILES": [
        "dir::../../verilog/rtl/defines.v",
        "dir::../../verilog/rtl/user_project_wrapper.v",
        "dir::../../verilog/rtl/microwatt_soc.v",
        "dir::../../verilog/rtl/microwatt_wrapper.v"
    ],

    "//": "=== SDC ===",
    "PNR_SDC_FILE": "dir::signoff.sdc",
    "SIGNOFF_SDC_FILE": "dir::signoff.sdc",
    
    "//": "=== Hardening strategy ===",
    "SYNTH_ELABORATE_ONLY": false,
    "RUN_POST_GPL_DESIGN_REPAIR": true,
    "RUN_POST_CTS_RESIZER_TIMING": true,
    "DESIGN_REPAIR_BUFFER_INPUT_PORTS": true,
    "FP_PDN_ENABLE_RAILS": true,
    "RUN_ANTENNA_REPAIR": true,
    "RUN_FILL_INSERTION": true,
    "RUN_TAP_ENDCAP_INSERTION": true,
    "RUN_CTS": true,
    "RUN_IRDROP_REPORT": true,
    "ERROR_ON_SYNTH_CHECKS": true,
    "SYNTH_USE_PG_PINS_DEFINES": "USE_POWER_PINS",

    "MACROS": {
        "CF_SRAM_1024x32_wb_wrapper": {
            "gds": [
                "dir::../../gds/CF_SRAM_1024x32_wb_wrapper.gds"
            ],
            "lef": [
                "dir::../../lef/CF_SRAM_1024x32_wb_wrapper.lef"
            ],
            "instances": {
                "microwatt_soc_inst.CF_SRAM_1024x32_wb_wrapper": {
                    "location": [1270, 1543],
                    "orientation": "N"
                }
            },
            "nl": [
                "dir::../../verilog/gl/CF_SRAM_1024x32_wb_wrapper.v"
            ],
            "spef": {
                "min_*": [
                    "dir::../../spef/multicorner/CF_SRAM_1024x32_wb_wrapper.min.spef"
                ],
                "nom_*": [
                    "dir::../../spef/multicorner/CF_SRAM_1024x32_wb_wrapper.nom.spef"
                ],
                "max_*": [
                    "dir::../../spef/multicorner/CF_SRAM_1024x32_wb_wrapper.max.spef"
                ]
            },
            "lib": {
                "*": "dir::../../lib/CF_SRAM_1024x32_wb_wrapper.lib"
            }
        }
    },

    "PDN_MACRO_CONNECTIONS": [
        "microwatt_soc_inst.CF_SRAM_1024x32_wb_wrapper vccd1 vssd1 VPWR VGND"
    ],

    "//": "=== PDN configurations ===",
    "FP_PDN_VOFFSET": 5,
    "FP_PDN_HOFFSET": 5,
    "FP_PDN_VWIDTH": 3.1,
    "FP_PDN_HWIDTH": 3.1,
    "FP_PDN_VSPACING": 15.5,
    "FP_PDN_HSPACING": 15.5,
    "FP_PDN_VPITCH": 180,
    "FP_PDN_HPITCH": 180,
    "ERROR_ON_PDN_VIOLATIONS": false,

    "//": "=== Routing ===",
    "DRT_THREADS": 16,
    "MAX_TRANSITION_CONSTRAINT": 1.5,

    "//": "=== Fixed Caravel configurations - DO NOT EDIT ===",
    "DESIGN_NAME": "user_project_wrapper",
    "FP_SIZING": "absolute",
    "DIE_AREA": [0, 0, 2920, 3520],
    "FP_DEF_TEMPLATE": "dir::fixed_dont_change/user_project_wrapper.def",
    
    "//": "=== Power nets ===",
    "VDD_NETS": ["vccd1", "vccd2", "vdda1", "vdda2"],
    "GND_NETS": ["vssd1", "vssd2", "vssa1", "vssa2"],
    
    "//": "=== PDN Core Ring ===",
    "FP_PDN_CORE_RING": true,
    "FP_PDN_CORE_RING_VWIDTH": 3.1,
    "FP_PDN_CORE_RING_HWIDTH": 3.1,
    "FP_PDN_CORE_RING_VOFFSET": 12.45,
    "FP_PDN_CORE_RING_HOFFSET": 12.45,
    "FP_PDN_CORE_RING_VSPACING": 1.7,
    "FP_PDN_CORE_RING_HSPACING": 1.7,

    "//": "=== Clock ===",
    "CLOCK_PORT": "wb_clk_i",
    "CLOCK_PERIOD": 25,

    "MAGIC_ZEROIZE_ORIGIN": false,

    "meta": {
        "version": 2
    },
    "PRIMARY_GDSII_STREAMOUT_TOOL": "klayout",
    "SYNTH_ABC_BUFFERING": true,
    "SYNTH_SIZING": true,
    "RUN_KLAYOUT_DRC": true,
    "RUN_MAGIC_DRC": false,
    "RUN_KLAYOUT_XOR": false,
    
    "MAGIC_EXT_USE_GDS": false,
    "MAGIC_CAPTURE_ERRORS": false,
    "MAGIC_DEF_LABELS": false,
    "MAGIC_DRC_USE_GDS": true,

    "ERROR_ON_MAGIC_DRC": false,
    "ERROR_ON_ILLEGAL_OVERLAPS": false,
    "GRT_ALLOW_CONGESTION": true,
    "STA_CORNERS": [
        "nom_tt_025C_1v80",
        "min_tt_025C_1v80",
        "max_tt_025C_1v80"
    ],

    "//": "=== Hold Fixing Parameters (increased from 0.5 to 0.6) ===",
    "PL_RESIZER_HOLD_SLACK_MARGIN": 0.6,
    "GRT_RESIZER_HOLD_SLACK_MARGIN": 0.6,

    "//": "=== Routing DRC Fixes ===",
    "DRT_OPT_ITERS": 64,
    "GRT_OVERFLOW_ITERS": 150,

    "//": "=== Error Control ===",
    "ERROR_ON_KLAYOUT_DRC": false,
    "ERROR_ON_LVS_ERROR": false,

    "RUN_HEURISTIC_DIODE_INSERTION": true,
    "RUN_POST_GRT_DESIGN_REPAIR": true,
    "RUN_POST_GRT_RESIZER_TIMING": true,
    "GRT_ANTENNA_ITERS": 20,
    "GRT_ANTENNA_MARGIN": 15
}