{
    "DESIGN_NAME": "user_proj_example",
    "VERILOG_FILES": [
        "dir::../../verilog/rtl/defines.v",
        "dir::../../verilog/rtl/user_proj_example.v",
        "dir::../../verilog/rtl/microwatt_soc.v",
        "dir::../../verilog/rtl/microwatt_wrapper.v"
    ],

    "SYNTH_ELABORATE_ONLY": false,
    "RUN_POST_GPL_DESIGN_REPAIR": true,
    "RUN_POST_CTS_RESIZER_TIMING": true,
    "DESIGN_REPAIR_BUFFER_INPUT_PORTS": true,
    "FP_PDN_ENABLE_RAILS": true,
    "RUN_FILL_INSERTION": true,
    "RUN_TAP_ENDCAP_INSERTION": true,
    "RUN_CTS": true,
    "RUN_IRDROP_REPORT": true,
    "ERROR_ON_SYNTH_CHECKS": false,
    "QUIT_ON_MAGIC_DRC": false,

    "//": "Macros configurations",
  "MACROS": {
    "CF_SRAM_1024x32_wb_wrapper": {
      "gds": [
        "dir::../../gds/CF_SRAM_1024x32_wb_wrapper.gds"
      ],
      "lef": [
        "dir::../../lef/CF_SRAM_1024x32_wb_wrapper.lef"
      ],
      "instances": {
        "microwatt_soc_inst.CF_SRAM_1024x32_wb_wrapper": {
          "location": [200, 200],
          "orientation": "N"
        }
      },
      "nl": [
        "dir::../../verilog/gl/CF_SRAM_1024x32_wb_wrapper.v"
      ],
      "spef": {
        "min_*": [
          "dir::../../spef/multicorner/CF_SRAM_1024x32_wb_wrapper.min.spef"
        ],
        "nom_*": [
          "dir::../../spef/multicorner/CF_SRAM_1024x32_wb_wrapper.nom.spef"
        ],
        "max_*": [
          "dir::../../spef/multicorner/CF_SRAM_1024x32_wb_wrapper.max.spef"
        ]
      },
      "lib": {
        "*": "dir::../../lib/CF_SRAM_1024x32_wb_wrapper.lib"
        }
      }
    },

    "PDN_MACRO_CONNECTIONS": [
    "microwatt_soc_inst.CF_SRAM_1024x32_wb_wrapper VPWR VGND"
  ],

    "CLOCK_PERIOD": 25,
    "CLOCK_PORT": "wb_clk_i",
    "CLOCK_NET": "microwatt_soc.sys_clk",
    "FP_SIZING": "absolute",
    "DIE_AREA": [
        0,
        0,
        2800,
        1760
    ],
    
  "//PDN_SETTINGS": "PDN configuration from working wrapper config",
  "FP_PDN_MACRO_HOOKS": "microwatt_soc_inst.CF_SRAM_1024x32_wb_wrapper vccd1 vssd1 VPWR VGND",
  "SYNTH_POWER_DEFINE": "USE_POWER_PINS",
  "FP_PDN_CHECK_NODES": false,
  "FP_PDN_CORE_RING": true,
  "FP_PDN_ENABLE_MACROS_GRID": true,
  "FP_PDN_ENABLE_GLOBAL_CONNECTIONS": true,
  "ROUTING_CORES": 16, 

    "// ANTENNA STRATEGY": "Choose ONE approach - using strategy-based insertion",
    "RUN_ANTENNA_REPAIR": true,
    "RUN_HEURISTIC_DIODE_INSERTION": false,
    "DIODE_INSERTION_STRATEGY": 3,
    "GRT_ANTENNA_ITERS": 5,
    "GRT_ANTENNA_MARGIN": 15,
    "GRT_MAX_DIODE_INS_ITERS": 3,
    "HEURISTIC_ANTENNA_THRESHOLD": 100,
    "// DENSITY CONTROL": "Critical for fixed die area",
    "FP_CORE_UTIL": 38,
    "PL_TARGET_DENSITY_PCT": 45,
    "SYNTH_BUFFERING": true,
    "SYNTH_SIZING": true,   
  
    
    "FP_PIN_ORDER_CFG": "dir::pin_order.cfg",
    "MAX_TRANSITION_CONSTRAINT": 1.0,
    "MAX_FANOUT_CONSTRAINT": 16,
    "PL_RESIZER_SETUP_SLACK_MARGIN": 0.4,
    "GRT_RESIZER_SETUP_SLACK_MARGIN": 0.2,
    "GRT_RESIZER_HOLD_SLACK_MARGIN": 0.25,
    "PL_RESIZER_HOLD_SLACK_MARGIN": 0.5,
    "CTS_CLK_MAX_WIRE_LENGTH": 500,
    "MAGIC_DEF_LABELS": false,
    "SYNTH_ABC_BUFFERING": false,

    "DRT_OPT_ITERS": 64,
    "GRT_ALLOW_CONGESTION": true,
    "GRT_OVERFLOW_ITERS": 200,

    "RUN_POST_GRT_DESIGN_REPAIR": true,
    "RUN_POST_GRT_RESIZER_TIMING": true,

    "VDD_NETS": ["vccd1"],
    "GND_NETS": ["vssd1"],
    "VDD_PIN": "VPWR",
    "GND_PIN": "VGND",

    "FALLBACK_SDC_FILE": "dir::base_user_proj_example.sdc",
    "MAGIC_DRC_USE_GDS": true,
    "DPL_CELL_PADDING": 2,
    "GPL_CELL_PADDING": 2,
    "pdk::sky130*": {
        "RT_MAX_LAYER": "met4",
        "scl::sky130_fd_sc_hd": {
            "CLOCK_PERIOD": 25
        },
        "scl::sky130_fd_sc_hdll": {
            "CLOCK_PERIOD": 10
        },
        "scl::sky130_fd_sc_hs": {
            "CLOCK_PERIOD": 8
        },
        "scl::sky130_fd_sc_ls": {
            "CLOCK_PERIOD": 10,
            "SYNTH_MAX_FANOUT": 5
        },
        "scl::sky130_fd_sc_ms": {
            "CLOCK_PERIOD": 10
        }
    },
    "pdk::gf180mcuC": {
        "STD_CELL_LIBRARY": "gf180mcu_fd_sc_mcu7t5v0",
        "CLOCK_PERIOD": 24.0,
        "RT_MAX_LAYER": "Metal4",
        "SYNTH_MAX_FANOUT": 4,
        "PL_TARGET_DENSITY_PCT": 45
    },
    "meta": {
        "version": 2
    }
}
